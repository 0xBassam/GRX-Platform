{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd apps/web && pnpm build",
  "installCommand": "cd apps/web && pnpm install",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "apps/web/app/api/generate/route.ts": { "maxDuration": 120 },
    "apps/web/app/api/export/pdf/route.ts": { "maxDuration": 60 },
    "apps/web/app/api/export/docx/route.ts": { "maxDuration": 60 },
    "apps/web/app/api/insights/route.ts": { "maxDuration": 60 }
  }
}
