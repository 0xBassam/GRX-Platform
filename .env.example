# Anthropic (chat + policy generation)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings only: text-embedding-3-large)
OPENAI_API_KEY=sk-...

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Demo mode (optional). When set to 1 the chat page shows preloaded queries
# and serves cached responses for those queries.
GRX_DEMO_MODE=0

# Model selection (optional overrides)
GRX_CHAT_MODEL=claude-sonnet-4-6
GRX_POLICY_MODEL=claude-opus-4-7
GRX_EMBEDDING_MODEL=text-embedding-3-large
